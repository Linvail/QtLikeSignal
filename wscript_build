from waflib import Options, Logs
import platform, os


def select_toolchain(bld):
    selected_toolchain = bld.toolchain
    if selected_toolchain:
        return selected_toolchain

    host_platform = platform.system()
    if host_platform == "Windows":
        return "win64-msvc"
    elif host_platform == "Linux" and bld.env.DEST_OS == "win32":
        # Cross-compiling from Linux to Windows.
        return "linux-2-win64-clang"
    elif host_platform == "Linux":
        return "linux64-clang"
    else:
        bld.fatal("Unsupported host platform: %s" % host_platform)


def make_toolchain_with_mode(bld, toolchain_name):
    full_toolchain_name = "%s-%s" % (toolchain_name, bld.mode)

    try:
        e = bld.all_envs[full_toolchain_name]
    except KeyError:
        # Fallback to the base toolchain if the toolchain with mode is not found.
        e = bld.all_envs[toolchain_name]
    if not e.ENV_VALID:
        bld.fatal(
            "Toolchain '%s' is not valid. Please check the configuration and try again."
            % toolchain_name
        )
    else:
        return e.derive()


def build_tests(bld):
    toolchain = select_toolchain(bld)
    env = make_toolchain_with_mode(bld, toolchain)
    bld.set_env(env)

    bld.apply_sanitizer_settings()

    if (
        platform.system() == "Windows"
        and bld.env.DEST_OS == "win32"
        and bld.ASan_enabled
    ):
        bld.add_AddressSanitizer_on_Windows()

    bld.recurse("submodules/external")
    bld.recurse("src")


product_table = {
    "Tests": build_tests,
}

product_table[bld.project](bld)

if not Options.options.destdir:
    Options.options.destdir = os.path.join("install", bld.variant)
    Logs.info("destdir is not specified, use default: %s" % Options.options.destdir)
if not os.path.isabs(Options.options.destdir):
    Options.options.destdir = os.path.normpath(
        os.path.join(bld.top_dir, Options.options.destdir)
    )
    Logs.info("Installation directory: %s" % Options.options.destdir)
