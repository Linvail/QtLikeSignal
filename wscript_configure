from waflib import Configure, Context, Errors, Options, Utils, Logs
from waflib.Configure import conf
import glob, os


##
# @brief Checks if the Boost headers are present and bootstraps them if they are missing.
#
# @param ctx The Waf ConfigurationContext.
#
#
# Only boost::signals2 is used by this project. Pulling the full Boost
# superproject recursively fetches ~170 unrelated library submodules
# (700+MB). Instead we only init signals2, its transitive dependencies
# (computed via `boostdep --list-dependencies signals2`), and the two
# tools submodules needed to bootstrap b2 and generate the header tree.
#
_BOOST_REQUIRED_LIBS = [
    "assert", "bind", "concept_check", "config", "container_hash", "core",
    "describe", "detail", "function", "function_types", "fusion", "headers",
    "integer", "io", "iterator", "move", "mp11", "mpl", "optional", "parameter",
    "predef", "preprocessor", "signals2", "smart_ptr", "throw_exception", "tuple",
    "type_index", "type_traits", "typeof", "utility", "variant",
]
_BOOST_REQUIRED_TOOLS = ["build", "boost_install"]


def check_and_bootstrap_boost(ctx):
    import sys, subprocess

    boost_dir = os.path.join(ctx.path.abspath(), "submodules", "external", "boost")
    boost_headers_dir = os.path.join(boost_dir, "boost")
    core_check_file = os.path.join(boost_headers_dir, "core", "checked_delete.hpp")
    if not os.path.exists(boost_headers_dir) or not os.path.exists(core_check_file):
        Logs.info(
            "Boost headers directory not found. Bootstrapping Boost and generating headers..."
        )
        if not os.path.exists(boost_dir) or not os.listdir(boost_dir):
            Logs.error(
                "Boost submodule is not initialized. Please run: git submodule update --init submodules/external/boost"
            )
            sys.exit(1)

        submodule_paths = ["libs/%s" % lib for lib in _BOOST_REQUIRED_LIBS]
        submodule_paths += ["tools/%s" % tool for tool in _BOOST_REQUIRED_TOOLS]
        Logs.info("Initializing required Boost submodules (signals2 + dependencies)...")
        res = subprocess.run(
            ["git", "submodule", "update", "--init"] + submodule_paths,
            cwd=boost_dir,
            capture_output=True,
            text=True,
        )
        if res.returncode != 0:
            Logs.error("Failed to initialize Boost submodules:\n%s" % res.stderr)
            sys.exit(res.returncode)

        is_windows = sys.platform.startswith("win")
        try:
            if is_windows:
                bootstrap_cmd = "bootstrap.bat"
                b2_exe = os.path.join(boost_dir, "b2.exe")
                Logs.info("Running bootstrap.bat...")
                res = subprocess.run(
                    [bootstrap_cmd],
                    cwd=boost_dir,
                    shell=True,
                    capture_output=True,
                    text=True,
                )
                if res.returncode != 0:
                    Logs.error("Boost bootstrap failed:\n%s" % res.stderr)
                    sys.exit(res.returncode)
                Logs.info("Running b2 headers...")
                res = subprocess.run(
                    [b2_exe, "headers"], cwd=boost_dir, capture_output=True, text=True
                )
                if res.returncode != 0:
                    Logs.error("Boost b2 headers generation failed:\n%s" % res.stderr)
                    sys.exit(res.returncode)
            else:
                bootstrap_cmd = "./bootstrap.sh"
                b2_exe = "./b2"
                Logs.info("Running bootstrap.sh...")
                res = subprocess.run(
                    [bootstrap_cmd], cwd=boost_dir, capture_output=True, text=True
                )
                if res.returncode != 0:
                    Logs.error("Boost bootstrap failed:\n%s" % res.stderr)
                    sys.exit(res.returncode)
                Logs.info("Running b2 headers...")
                res = subprocess.run(
                    [b2_exe, "headers"], cwd=boost_dir, capture_output=True, text=True
                )
                if res.returncode != 0:
                    Logs.error("Boost b2 headers generation failed:\n%s" % res.stderr)
                    sys.exit(res.returncode)
            Logs.info("Boost headers generated successfully.")
        except Exception as e:
            Logs.error("Failed to automatically generate Boost headers: %s" % e)
            sys.exit(1)


check_and_bootstrap_boost(ctx)

local_tools = [
    "variant-builder",
    "toolchains",
    "debug-info",
    "sanitizer"
]

ctx.load(local_tools, tooldir="tools")
ctx.load("clang_compilation_database", tooldir="submodules/external/waf/waflib/extras")


# Track all tools files for Waf's autoconfig Node hashing
if os.path.exists("tools"):
    for f in glob.glob("tools/**/*.py", recursive=True):
        abspath = os.path.abspath(f)
        ctx.files.append(abspath)
        ctx.hash = Utils.h_list((ctx.hash, Utils.readf(abspath, "rb")))
