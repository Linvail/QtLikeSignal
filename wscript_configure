# Boost is gone. QtLikeSignal took its signal from boost::signals2 originally and QtMimic followed;
# both have their own Signal now, and nothing in src/ or external/ includes a boost header. What used
# to live here was a bootstrap that initialised ~30 boost submodules and ran b2 to generate the
# header tree, because pulling the full superproject fetches ~170 unrelated libraries. Removing the
# dependency removes the need for all of it, and for the submodule.
from waflib import Utils
import glob, os

local_tools = [
    "variant-builder",
    "toolchains",
    "debug-info",
    "sanitizer"
]

ctx.load(local_tools, tooldir="tools")
ctx.load("clang_compilation_database", tooldir="submodules/external/waf/waflib/extras")


# Track all tools files for Waf's autoconfig Node hashing
if os.path.exists("tools"):
    for f in glob.glob("tools/**/*.py", recursive=True):
        abspath = os.path.abspath(f)
        ctx.files.append(abspath)
        ctx.hash = Utils.h_list((ctx.hash, Utils.readf(abspath, "rb")))
