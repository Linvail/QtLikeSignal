def build(bld):
    """
    Build the QtMimic library and its test program.
    """
    kw = {}
    kw["use"] = []
    kw["features"] = ["cxx"]
    kw["source"] = bld.path.ant_glob(
        "src/*.cpp",
        excl=[
            "src/ThreadWin.cpp",
            "src/ThreadPosix.cpp",
            "src/EventDispatcherWin32.cpp",
            "src/EventDispatcherLinux.cpp",
        ],
    )
    if bld.env.DEST_OS == "win32":
        kw["source"].append(bld.path.find_node("src/ThreadWin.cpp"))
        kw["source"].append(bld.path.find_node("src/EventDispatcherWin32.cpp"))
    elif bld.env.DEST_OS == "linux":
        kw["source"].append(bld.path.find_node("src/ThreadPosix.cpp"))
        kw["source"].append(bld.path.find_node("src/EventDispatcherLinux.cpp"))
    kw["includes"] = "src"
    kw["export_includes"] = "src"

    build_shared_lib = getattr(bld.env, "QT_MIMIC_BUILD_SHARED_LIB", False)
    if build_shared_lib and bld.env.DEST_OS != "win32":
        kw["features"].append("cxxshlib")

    bld(target="QtMimic", **kw)

    kw_test = {}
    if bld.env.DEST_OS == "win32" and "msvc" in bld.env.CXX_NAME:
        kw_test["linkflags"] = ["/SUBSYSTEM:CONSOLE"]

    bld.program(
        target="QtMimic-test",
        use=["QtMimic", "google-test"],
        features=["cxx", "cxxprogram"],
        source=bld.path.ant_glob("tests/*.cpp"),
        **kw_test,
    )
