def build(bld):
    """
    Build the QtMimic library and its test program.
    """
    kw = {}
    kw["use"] = []
    kw["features"] = ["cxx"]
    kw["source"] = bld.path.ant_glob(
        "src/QtMimic/*.cpp",
        excl=[
            "src/QtMimic/ThreadWin.cpp",
            "src/QtMimic/ThreadPosix.cpp",
            "src/QtMimic/EventDispatcherWin32.cpp",
            "src/QtMimic/EventDispatcherLinux.cpp",
        ],
    )
    if bld.env.DEST_OS == "win32":
        kw["source"].append(bld.path.find_node("src/QtMimic/ThreadWin.cpp"))
        kw["source"].append(bld.path.find_node("src/QtMimic/EventDispatcherWin32.cpp"))
    elif bld.env.DEST_OS == "linux":
        kw["source"].append(bld.path.find_node("src/QtMimic/ThreadPosix.cpp"))
        kw["source"].append(bld.path.find_node("src/QtMimic/EventDispatcherLinux.cpp"))
    # src/QtMimic/ holds the sources; src/ is what goes on the include path, so every include of a
    # QtMimic header is written "QtMimic/Object.hpp". All thirteen header names also exist in
    # QtLikeSignal, so an unprefixed include resolves by include-path order rather than by intent.
    kw["includes"] = "src"
    kw["export_includes"] = "src"

    build_shared_lib = getattr(bld.env, "QT_MIMIC_BUILD_SHARED_LIB", False)
    if build_shared_lib and bld.env.DEST_OS != "win32":
        kw["features"].append("cxxshlib")

    bld(target="QtMimic", **kw)

    kw_test = {}
    if bld.env.DEST_OS == "win32":
        # EventDispatcherWin32 calls CreateWindowEx/PeekMessage/DispatchMessage, all of which live
        # in user32. src/tests/wscript has always linked it; this one had not, so the QtMimic test
        # program was the only Windows target that did not link.
        kw_test["lib"] = ["user32"]
    if bld.env.DEST_OS == "win32" and "msvc" in bld.env.CXX_NAME:
        kw_test["linkflags"] = ["/SUBSYSTEM:CONSOLE"]

    bld.program(
        target="QtMimic-test",
        use=["QtMimic", "google-test"],
        features=["cxx", "cxxprogram"],
        source=bld.path.ant_glob("tests/*.cpp"),
        **kw_test,
    )
