def build(bld):
    kw = {}
    kw["includes"] = ["."]
    kw["export_includes"] = ["."]
    # No boost. QtLikeSignal used to get its signal from boost::signals2; it has its own now
    # (src/Signal.hpp, src/Connection.hpp). QtMimic still depends on boost, so the submodule stays.
    kw["use"] = []
    kw["features"] = ["cxx", "debug-info"]

    kw["source"] = [
        "AbstractEventDispatcher.cpp",
        "CoreApplication.cpp",
        "EventDispatcherDefault.cpp",
        "Object.cpp",
        "Thread.cpp",
        "ThreadData.cpp",
        "Timer.cpp",
    ]

    if bld.env.DEST_OS == "win32":
        kw["source"] += [
            "EventDispatcherWin32.cpp",
            "ThreadWin.cpp",
        ]
    elif bld.env.DEST_OS == "linux":
        kw["source"] += [
            "EventDispatcherLinux.cpp",
            "ThreadPosix.cpp",
        ]

    bld(target="QtLikeSignal", **kw)

    bld.recurse("tests")
