def build(bld):
    """
    Build QtLikeSignal and everything that sits beside it.

    Five parts, each with its own wscript next to its own sources, so that no build script globs
    into a directory it does not own and every source list is written in local names.

    Read in groups: the two libraries first -- QtLikeSignal, and QtLikeSignalGui over it -- then the
    three things that exercise them (tests, demo, perf). That grouping is for whoever reads this
    list, not for waf, which resolves a target's "use" wherever it was declared and would build
    these in any order.
    """
    bld.recurse("QtLikeSignal")
    bld.recurse("QtLikeSignalGui")
    bld.recurse("tests")
    bld.recurse("demo")
    bld.recurse("perf")
