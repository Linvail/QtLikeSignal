def _have_x11(bld):
    """
    Report whether X11 is available to this toolchain.

    HAVE_X11 is set by check_cfg() in tools/toolchain-linux.py, which runs only for the two native
    Linux toolchains -- so the cross-compile to Windows answers false here without this function
    having to know it targets Windows. The include and library paths pkg-config reported come with
    it as the X11 uselib, so a target writes use=["X11"] instead of naming "-lX11" and guessing at
    an include directory.

    Replaced a hand-rolled search for X11/Xlib.h under a list of prefixes, which could only ever
    answer whether a file existed on the *build* machine.
    """
    return bool(bld.env.HAVE_X11)


def _build_windows_demo(bld):
    """
    Build the Win32 demo program.

    The cross toolchain (linux-2-win64-clang) also targets win32 and does build it, which is the
    only compiler other than MSVC that sees this code.
    """
    kw = {}
    kw["features"] = ["cxx", "cxxprogram", "debug-info"]
    kw["source"] = bld.path.ant_glob("windows/*.cpp")
    # The demo's own headers are included unprefixed ("GuiApplication.hpp"), so its directory goes
    # on the include path, and common/ with it for the MouseEvent both demos share. QtLikeSignal's src/
    # is already there via the QtLikeSignal use below, which is what makes the library's own includes
    # read "QtLikeSignal/CoreApplication.hpp".
    kw["includes"] = ["windows", "common"]
    # user32 for the window and its messages, gdi32 for the painting, both as uselibs the Windows
    # toolchains declare -- the same way the Linux targets name X11.
    kw["use"] = ["QtLikeSignal", "USER32", "GDI32"]

    bld(target="QtLikeSignal-Demo-Windows", **kw)


def _build_gui_demo(bld):
    """
    Build the QtLikeSignalGui demo: the same program as the Win32 demo, written against the library.

    Worth having both. demo/windows/ shows what the dispatcher does for a program that owns its own
    window procedure; this one shows the same events arriving after QtLikeSignalGui has taken that job
    over, with the drawing left to whoever holds the HWND -- which is the position an external
    WGL library is in.
    """
    kw = {}
    kw["features"] = ["cxx", "cxxprogram", "debug-info"]
    kw["source"] = bld.path.ant_glob("gui/*.cpp")
    # USER32 arrives through QtLikeSignalGui, which named it for its own window procedure and whose
    # uselibs waf carries down the use chain. GDI32 is this demo's alone: the painting is the
    # demo's, not the library's, which is the whole point of the split.
    kw["use"] = ["QtLikeSignalGui", "QtLikeSignal", "GDI32"]

    bld(target="QtLikeSignalGui-Demo", **kw)


def _build_gui_x11_demo(bld):
    """
    Build the QtLikeSignalGui X11 demo, if the X11 development headers are installed.

    The Linux counterpart of the QtLikeSignalGui demo: the same program, adopting a window an external
    library created rather than creating one. Skipped with a message when X11 is unavailable, for
    the same reason the plain X11 demo is.
    """
    if not _have_x11(bld):
        bld.build_msg("QtLikeSignalGui X11 demo", "skipped (install libx11-dev)", color="YELLOW")
        return

    kw = {}
    kw["features"] = ["cxx", "cxxprogram", "debug-info"]
    kw["source"] = bld.path.ant_glob("gui-x11/*.cpp")

    # X11 twice over, and only named once. This demo calls Xlib itself, so it says so; QtLikeSignalGui's
    # X11 backend named it too, and its libinput -- which this program never touches but still has
    # to link -- comes along the use chain without being repeated here. That propagation is what
    # replaced a hand-kept list of every library any backend might have been compiled with.
    kw["use"] = ["QtLikeSignalGui", "QtLikeSignal", "X11"]

    bld(target="QtLikeSignalGui-Demo-X11", **kw)


def _build_gui_wayland_demo(bld):
    """
    Build the QtLikeSignalGui Wayland demo, if libwayland is installed.

    The Wayland counterpart of the QtLikeSignalGui demo: the library creates the surface and delivers the
    input, and the program attaches the buffer -- which is the division every backend makes, drawn
    here with shared memory instead of EGL so that the demo needs no GL stack to run.
    """
    if not bld.env.HAVE_WAYLAND_CLIENT:
        bld.build_msg("QtLikeSignalGui Wayland demo", "skipped (install libwayland-dev)", color="YELLOW")
        return

    kw = {}
    kw["features"] = ["cxx", "cxxprogram", "debug-info"]
    kw["source"] = bld.path.ant_glob("gui-wayland/*.cpp")

    # WAYLAND-CLIENT arrives through QtLikeSignalGui, whose Wayland backend named it, but this program
    # calls wl_shm and wl_registry itself -- so it says so rather than relying on what it is handed.
    kw["use"] = ["QtLikeSignalGui", "QtLikeSignal", "WAYLAND-CLIENT"]

    bld(target="QtLikeSignalGui-Demo-Wayland", **kw)


def _build_x11_demo(bld):
    """
    Build the X11 demo program, if the X11 development headers are installed.

    Skipped with a message rather than failing the build when they are not: the demo needs a
    window system that a build machine has no reason to have, and the library itself does not
    depend on X11 at all.
    """
    if not _have_x11(bld):
        bld.build_msg("X11 demo", "skipped (install libx11-dev)", color="YELLOW")
        return

    kw = {}
    kw["features"] = ["cxx", "cxxprogram", "debug-info"]
    kw["source"] = bld.path.ant_glob("x11/*.cpp")
    kw["includes"] = ["x11", "common"]

    # X11 is the uselib check_cfg() filled in, carrying the include directories, the library
    # directories and the library list that pkg-config reported. It replaced a hand-written
    # lib=["X11"] plus a conditional include path, which between them said less and could be wrong.
    kw["use"] = ["QtLikeSignal", "X11"]

    bld(target="QtLikeSignal-Demo-X11", **kw)


def build(bld):
    """
    Build the demos the target platform has a window system for.

    Two families, and the difference between them is the point.

    The QtLikeSignalGui-Demo-* programs are how a program is meant to be written on this library: no
    event loop of their own, no window-system call, nothing but signals and exec(). The
    QtLikeSignal-Demo-* ones own their window and their window system, and hand the connection to
    QtLikeSignal -- which is where a program with an existing toolkit, or an external GL library, finds
    itself. Both positions are real, so both are shown.

    There is no raw Wayland demo. There used to be, and it was 1578 lines demonstrating exactly
    what demo/x11/ demonstrates: take the connection's fd, hand it to
    EventDispatcherLinux::registerEventSource(), and let one poll() wait on everything. Two
    protocols reading a socket differently is a difference in the C API being called, not in
    anything about QtLikeSignal, and the lesson does not become truer for being told twice. Wayland is
    still covered as a platform by QtLikeSignalGui-Demo-Wayland; what went away was the second copy of
    the integration story, not the backend.

    Win32 is kept alongside X11 because it integrates by a genuinely different mechanism:
    EventDispatcherWin32::processPlatformEvents() pumps the OS queue from inside exec(), where the
    Linux backends register a file descriptor.
    """
    if bld.env.DEST_OS == "win32":
        _build_windows_demo(bld)
        _build_gui_demo(bld)
    elif bld.env.DEST_OS == "linux":
        _build_x11_demo(bld)
        _build_gui_x11_demo(bld)
        _build_gui_wayland_demo(bld)
