import os

# Where a locally-built Qt 6 is expected. The Qt 6 benchmarks are compiled into the performance
# binary only when this is present, so a machine without Qt still builds everything else.
QT6_PREFIX = "/usr/local/Qt-6.11.1"


def _find_qt6(bld):
    """
    Locate a usable Qt 6 for the performance benchmarks.

    Returns a dict of paths, or None when Qt 6 is unavailable. Qt is only wired in for native Linux
    builds: the cross-compile to Windows would not find these host paths, and the benchmarks are a
    development tool rather than something the shipped tests depend on.
    """
    if bld.env.DEST_OS != "linux":
        return None

    moc = os.path.join(QT6_PREFIX, "libexec", "moc")
    include = os.path.join(QT6_PREFIX, "include")
    lib = os.path.join(QT6_PREFIX, "lib")

    if not os.path.exists(moc):
        return None
    if not os.path.exists(os.path.join(include, "QtCore", "QObject")):
        return None

    return {"moc": moc, "include": include, "lib": lib}


# Where boost's headers may be. boost::signals2 is header-only, so this is a header path and nothing
# is ever linked from it -- `sudo apt install libboost-dev` is the whole dependency, and no boost
# submodule or bootstrap comes back with it. See bee83fe for why that matters.
BOOST_INCLUDE_CANDIDATES = ["/usr/include", "/usr/local/include"]


def _find_boost(bld):
    """
    Locate boost's headers for the boost::signals2 benchmarks.

    Returns a dict of paths, or None when boost is unavailable. Linux-only for the same reason
    _find_qt6 is: the comparison table is only meaningful where every column can be produced in one
    process, and the Qt 6 column is native-Linux only.
    """
    if bld.env.DEST_OS != "linux":
        return None

    for include in BOOST_INCLUDE_CANDIDATES:
        if os.path.exists(os.path.join(include, "boost", "signals2", "signal.hpp")):
            return {"include": include}

    return None


def build(bld):
    kw = {}
    kw["features"] = ["cxx", "cxxprogram", "debug-info"]
    # The performance benchmarks are their own binary with their own main(), and are far too slow
    # to belong in the correctness suite. Excluded here on both counts.
    kw["source"] = bld.path.ant_glob(
        "*.cpp",
        excl=[
            "test_QtLikeSignal_Performance.cpp",
            "test_QtLikeSignal_Regression.cpp",
            "test_Qt6_Performance.cpp",
            "test_Boost_Performance.cpp",
            "PerfAllocationCounter.cpp",
        ],
    )
    kw["includes"] = ["."]
    kw["use"] = ["QtLikeSignal", "google-test"]

    if bld.env.DEST_OS == "win32":
        kw["lib"] = ["user32"]

    bld(target="QtLikeSignal-Tests", **kw)

    kw = {}
    kw["features"] = ["cxx", "cxxprogram", "debug-info"]
    # The regression guards and the allocation counter ship with the benchmarks, not with the
    # correctness suite: the counter replaces global operator new, which no other binary should
    # carry, and the guards are only meaningful in an optimised build.
    kw["source"] = [
        "test_QtLikeSignal_Performance.cpp",
        "test_QtLikeSignal_Regression.cpp",
        "PerfAllocationCounter.cpp",
    ]
    kw["includes"] = ["."]
    kw["use"] = ["QtLikeSignal", "google-test"]

    if bld.env.DEST_OS == "win32":
        kw["lib"] = ["user32"]

    qt6 = _find_qt6(bld)
    if qt6:
        # A Qt signal has no body until moc writes one. Generate that into an ordinary .cpp and add
        # it to the sources, rather than the commoner trick of #include-ing a .moc at the bottom of
        # the file: the generated node is then a declared output, so waf knows to run moc before the
        # compile instead of that ordering being incidental.
        moc_output = bld.path.find_or_declare("moc_Qt6PerfObjects.cpp")
        bld(
            name="moc_Qt6PerfObjects",
            rule="%s -I%s ${SRC} -o ${TGT}" % (qt6["moc"], qt6["include"]),
            source="Qt6PerfObjects.hpp",
            target=moc_output,
        )

        kw["source"] += ["test_Qt6_Performance.cpp", moc_output]
        kw["includes"] += [qt6["include"], os.path.join(qt6["include"], "QtCore")]
        kw["libpath"] = [qt6["lib"]]
        kw["lib"] = kw.get("lib", []) + ["Qt6Core"]
        # Qt 6 is built position-independent, and rpath keeps the binary runnable without the
        # caller having to set LD_LIBRARY_PATH.
        kw["cxxflags"] = ["-fPIC"]
        kw["rpath"] = [qt6["lib"]]
    else:
        bld.msg(
            "Qt 6 performance benchmarks",
            "skipped (no Qt 6 at %s)" % QT6_PREFIX,
            color="YELLOW",
        )

    boost = _find_boost(bld)
    if boost:
        # Appended last on purpose. printSummary() makes whichever library recorded first the
        # baseline the ratio columns are expressed against, and registration order across
        # translation units follows link order, so keeping this after the others leaves QtLikeSignal
        # as the baseline it has always been.
        kw["source"] += ["test_Boost_Performance.cpp"]
        # /usr/include is already on the compiler's search path, and passing it as -I moves it ahead
        # of the toolchain's own directories, which breaks the #include_next chain libstdc++ relies
        # on. Only a non-default prefix needs saying out loud.
        if boost["include"] != "/usr/include":
            kw["includes"] += [boost["include"]]
    else:
        bld.msg(
            "boost::signals2 performance benchmarks",
            "skipped (no boost headers; apt install libboost-dev)",
            color="YELLOW",
        )

    bld(target="QtLikeSignal-Performance-Tests", **kw)
