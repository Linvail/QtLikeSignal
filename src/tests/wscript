def build(bld):
    """
    Build QtLikeSignal-test: every test in this directory, in one program.
    """
    kw_test = {}

    # No library and no define is named here, in either direction. EventDispatcherWin32 needs
    # user32 and QtLikeSignalGui's backends need Xlib and libinput, but all three arrive as
    # uselibs through use=["QtLikeSignalGui"] below -- waf propagates them down the use chain.
    # And the X11 tests guard themselves on HAVE_X11, which check_cfg() defines for the whole
    # build.
    if bld.env.DEST_OS == "win32" and "msvc" in bld.env.CXX_NAME:
        kw_test["linkflags"] = ["/SUBSYSTEM:CONSOLE"]

    bld.program(
        target="QtLikeSignal-test",
        # QtLikeSignalGui as well as QtLikeSignal: the GUI tests are in the same binary rather
        # than in one of their own, because most of what they cover -- the input types,
        # platform selection, the null-window guards -- is portable and would otherwise need a
        # second test program that existed only on Windows.
        use=["QtLikeSignal", "QtLikeSignalGui", "google-test"],
        features=["cxx", "cxxprogram"],
        source=bld.path.ant_glob("*.cpp"),
        **kw_test,
    )
